<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything both apps share and that has no UI: connecting (Streamable HTTP or stdio), listing
    tools/resources/prompts, formatting results, argument fields from a JSON schema, settings,
    history and encrypted headers. The WinForms app (Windows) and the Avalonia app (macOS, Linux,
    Windows) are thin UIs over it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpClientUI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

</Project>
